[user]
	name = Alex Palcuie
	email = alex.palcuie@gmail.com
	# Signing key is machine-local: set signingKey in ~/.gitconfiglocal,
	# or rely on the agent-provided key via gpg.ssh.defaultKeyCommand.
[core]
	editor = nvim
	excludesfile = ~/.gitignore
[merge]
	tool = vimdiff
[color]
	ui = auto
	interactive = auto
[push]
	default = current
[alias]
	co = checkout
	cm = commit
	st = status -sb
	br = branch
	undo = reset --hard HEAD
	amend = commit --amend -a
	graph = log --graph
	ignore = update-index --assume-unchanged
	unignore = update-index --no-assume-unchanged
	ignored = !git ls-files -v | grep "^[[:lower:]]"
	sweep = !git fsck && git gc && git remote update --prune && git stash clear
	update = !git checkout master && git checkout - && git merge master
	recent = !git branch --sort=-committerdate | head
[log]
	abbrevCommit = true
	decorate = true
[format]
	pretty = %C(yellow)%h%C(white)%d%Creset %s %C(cyan)(%cr) %C(bold blue)<%an>%Creset
[diff]
	algorithm = patience
[help]
	autocorrect = 1
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# Commit signing is machine-local (needs a key / agent): enable it in
# ~/.gitconfiglocal with commit.gpgsign = true.
[gpg]
	format = ssh
[gpg "ssh"]
	defaultKeyCommand = ssh-add -L
[fetch]
	prune = true
[include]
	path = ~/.gitconfiglocal
